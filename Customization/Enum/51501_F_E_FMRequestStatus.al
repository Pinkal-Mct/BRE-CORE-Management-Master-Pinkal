enum 51501 "FM Request Status"
{
    Extensible = true;

    value(0; " ")
    {
        Caption = ' ';
    }
    value(1; Open)
    {
        Caption = 'Open';
    }
    value(2; "Pending Approval")
    {
        Caption = 'Pending Approval';
    }
    value(3; Approved)
    {
        Caption = 'Approved';
    }
    value(4; Rejected)
    {
        Caption = 'Rejected';
    }
    value(5; "Work Order Created")
    {
        Caption = 'Work Order Created';
    }
    value(6; Closed)
    {
        Caption = 'Closed';
    }

}